{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studyflow-chat-media",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-16",
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "studyflow-one-view-photos" }
  ],
  "migrations_dir": "worker/migrations",
  "d1_databases": [
    { "binding": "DB", "database_name": "studyflow-chat-media" }
  ],
  "vars": {
    "SUPABASE_URL": "https://fegitfmwvycokzidtvtp.supabase.co"
  },
  "triggers": { "crons": ["*/15 * * * *"] }
}
