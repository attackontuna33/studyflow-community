      "binding": "DB",
      "database_name": "studyflow-chat-media",
      "database_id": "fde9482c-bf55-413c-bc20-7b70a2dc81d3"
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://fegitfmwvycokzidtvtp.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_W6yW9zfEQTzVolp4PEtlLQ_CRv7CdtC"
  },
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  }
}
